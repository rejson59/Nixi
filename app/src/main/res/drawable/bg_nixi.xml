<?xml version="1.0" encoding="utf-8"?>
<!--
  Tło okna: zaczyna się dokładnie od koloru paska statusu (#0B0716), więc
  między paskiem a treścią nie ma „szwu". Reszta to łagodne przejście w czerń.
  Ten sam gradient rysuje Compose (NixiBgGradient) — jeden wygląd, dwa miejsca.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#0B0716"
        android:centerColor="#0E0A1E"
        android:endColor="#07040F"
        android:type="linear" />
</shape>
